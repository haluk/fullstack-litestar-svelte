map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream api_backend { server api:8000; }
upstream web_backend { server web:3000; }
upstream keycloak_backend { server keycloak:8080; }

# Every request gets an id ($request_id) that is forwarded upstream as X-Request-ID and
# logged by nginx, SvelteKit and the API, so one user action can be traced end to end.
log_format main_rid '$remote_addr - $remote_user [$time_local] "$request" $status '
	'$body_bytes_sent "$http_referer" "$http_user_agent" rid=$request_id rt=$request_time';
access_log /var/log/nginx/access.log main_rid;

# Per-client-IP rate limits (the API also limits per signed-in user).
limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=web_per_ip:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=auth_per_ip:10m rate=10r/s;
limit_req_status 429;

# Compress text responses (SvelteKit's static assets are already pre-compressed).
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types application/json application/javascript text/css text/plain text/xml application/xml image/svg+xml;

server {
	listen 80;
	server_name {{ domain }};

	location /api/ {
		limit_req zone=api_per_ip burst=40 nodelay;

		add_header X-Content-Type-Options "nosniff" always;
		add_header Referrer-Policy "no-referrer" always;

		proxy_pass http://api_backend;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Request-ID $request_id;
	}

	# Keycloak (KC_HTTP_RELATIVE_PATH=/auth): login pages, OIDC endpoints, admin console.
	# Keycloak sets its own security headers (its admin console relies on framing).
	location /auth/ {
		limit_req zone=auth_per_ip burst=60 nodelay;

		proxy_pass http://keycloak_backend;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-Port $server_port;
		proxy_set_header X-Request-ID $request_id;
		proxy_buffer_size 16k;
		proxy_buffers 8 16k;
	}

	location / {
		limit_req zone=web_per_ip burst=100 nodelay;

		# The Content-Security-Policy comes from SvelteKit (vite.config.ts) because it
		# carries per-response nonces.
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "DENY" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
		# Enable once the site is served over HTTPS (browsers then refuse plain HTTP for a year):
		# add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

		proxy_pass http://web_backend;
		# the OIDC callback sets several token cookies; default buffers are too small
		proxy_buffer_size 16k;
		proxy_buffers 8 16k;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Request-ID $request_id;
	}
}
