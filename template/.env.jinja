# Generated with your answers. This file is git-ignored — keep real secrets here.
# Postgres
POSTGRES_DB={{ db_name }}
POSTGRES_USER={{ db_user }}
POSTGRES_PASSWORD={{ db_password }}

# Application
BACKEND_PORT={{ backend_port }}
FRONTEND_PORT={{ frontend_port }}
DOMAIN={{ domain }}

# Keycloak (authentication). KEYCLOAK_URL is the browser-facing URL (also the token issuer).
KEYCLOAK_URL=http://localhost:{{ keycloak_port }}
KEYCLOAK_REALM={{ project_slug }}
KEYCLOAK_CLIENT_ID={{ project_slug }}-web
KEYCLOAK_CLIENT_SECRET={{ keycloak_client_secret }}
KEYCLOAK_ADMIN_PASSWORD={{ keycloak_admin_password }}

# API hardening & observability (all optional; defaults shown)
LOG_LEVEL=INFO
# one log line per API request and response (tokens and cookies are masked)
LOG_REQUESTS=true
# comma-separated browser origins allowed to call the API directly; empty = CORS off
CORS_ORIGINS=
# comma-separated Host allowlist, e.g. api,{{ domain }}; empty = accept any
ALLOWED_HOSTS=
# requests per minute per signed-in user; 0 disables
RATE_LIMIT_PER_MINUTE=300
# expose Prometheus metrics at /metrics on the api service
METRICS_ENABLED=false

# Backend database connection (async).
# Host/port are for running the backend on your machine or against an external DB;
# inside Docker Compose the api uses the internal 'db' service instead.
DATABASE_URL=postgresql+asyncpg://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}

# Deployment (prod)
ORIGIN=http://{{ domain }}
INTERNAL_API_URL=http://api:8000
