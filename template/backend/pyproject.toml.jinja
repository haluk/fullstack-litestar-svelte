[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "{{ project_name }} backend (Litestar)"
requires-python = ">={{ python_version }}"
dependencies = [
    "litestar[standard,prometheus]>=2.25.0,<3",
    "advanced-alchemy>=1.12.0",
    "asyncpg>=0.32.0",
    "pydantic-settings>=2.16.2",
    "pyjwt[crypto]>=2.15.1",
    "msgspec>=0.22.0",
]

[dependency-groups]
dev = [
    "pytest>=9.2.0",
    "pytest-asyncio>=1.4.1",
    "testcontainers>=4.15.0",
    "cryptography>=50.0.2",
    "ruff>=0.17.3",
    "mypy>=2.4.1",
    "pre-commit>=4.7.0",
    "deptry>=0.25.1",
]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
markers = ["integration: needs a database (testcontainers Postgres)"]
filterwarnings = [
    # Litestar 2.24 forward-compat deprecations for inferred DI / path params.
    # Migrate to NamedDependency / FromPath when upgrading to Litestar 3.0.
    "ignore:.*Inferred dependency field.*",
    "ignore:.*deprecated inferred style.*",
    # Upstream advanced-alchemy calls its own deprecated set_async_context (removed upstream in 2.0).
    "ignore:.*set_async_context.*",
]

[tool.ruff]
target-version = "py{{ python_version | replace('.', '') }}"
line-length = 100

[tool.mypy]
python_version = "{{ python_version }}"
ignore_missing_imports = true

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]
