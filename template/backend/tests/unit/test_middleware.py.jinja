import logging
from collections.abc import AsyncIterator, Callable
from contextlib import asynccontextmanager
from typing import Any

import pytest
from litestar.testing import AsyncTestClient

from {{ package_name }}.app import create_app
from {{ package_name }}.config import Settings


@pytest.fixture
def client_with(token_verifier) -> Callable[..., Any]:
    @asynccontextmanager
    async def _client(**overrides: Any) -> AsyncIterator[AsyncTestClient]:
        async with AsyncTestClient(app=create_app(token_verifier, Settings(**overrides))) as client:
            yield client

    return _client


async def test_request_id_is_generated_and_echoed(app_client) -> None:
    generated = await app_client.get("/api/health")
    assert len(generated.headers["x-request-id"]) == 32

    echoed = await app_client.get("/api/health", headers={"X-Request-ID": "abc-123"})
    assert echoed.headers["x-request-id"] == "abc-123"


async def test_malformed_request_id_is_replaced(app_client) -> None:
    resp = await app_client.get("/api/health", headers={"X-Request-ID": "bad id\nwith newline"})
    assert resp.headers["x-request-id"] != "bad id\nwith newline"
    assert len(resp.headers["x-request-id"]) == 32


def test_comma_separated_settings_from_env(monkeypatch) -> None:
    monkeypatch.setenv("CORS_ORIGINS", "https://a.example, https://b.example")
    monkeypatch.setenv("ALLOWED_HOSTS", "")
    settings = Settings()
    assert settings.cors_origins == ["https://a.example", "https://b.example"]
    assert settings.allowed_hosts == []


async def test_cors_is_off_by_default(app_client) -> None:
    resp = await app_client.get("/api/health", headers={"Origin": "https://evil.example"})
    assert "access-control-allow-origin" not in resp.headers


async def test_cors_allows_only_configured_origins(client_with) -> None:
    async with client_with(cors_origins=["https://app.example"]) as client:
        preflight = await client.options(
            "/api/items",
            headers={
                "Origin": "https://app.example",
                "Access-Control-Request-Method": "GET",
                "Access-Control-Request-Headers": "authorization",
            },
        )
        assert preflight.status_code == 204
        assert preflight.headers["access-control-allow-origin"] == "https://app.example"

        other = await client.get("/api/health", headers={"Origin": "https://evil.example"})
        assert "access-control-allow-origin" not in other.headers


async def test_allowed_hosts_rejects_unknown_host(client_with) -> None:
    async with client_with(allowed_hosts=["api", "testserver.local"]) as client:
        assert (await client.get("/api/health")).status_code == 200
        assert (await client.get("/api/health", headers={"Host": "evil.example"})).status_code == 400


async def test_rate_limit_is_per_user(client_with, auth_headers) -> None:
    async with client_with(rate_limit_per_minute=2) as client:
        ada, bob = auth_headers(sub="ada"), auth_headers(sub="bob")
        assert (await client.get("/api/me", headers=ada)).status_code == 200
        assert (await client.get("/api/me", headers=ada)).status_code == 200
        limited = await client.get("/api/me", headers=ada)
        assert limited.status_code == 429
        assert (await client.get("/api/me", headers=bob)).status_code == 200  # own budget
        # probes are never limited
        for _ in range(3):
            assert (await client.get("/api/health")).status_code == 200


async def test_metrics_endpoint_only_when_enabled(app_client, client_with, auth_headers) -> None:
    assert (await app_client.get("/metrics")).status_code == 404
    async with client_with(metrics_enabled=True) as client:
        await client.get("/api/me", headers=auth_headers())
        resp = await client.get("/metrics")  # no token needed; nginx never routes it
        assert resp.status_code == 200
        assert "{{ package_name }}_requests_total" in resp.text


async def test_request_logs_never_contain_tokens(client_with, auth_headers) -> None:
    records: list[str] = []

    class Collect(logging.Handler):
        def emit(self, record: logging.LogRecord) -> None:
            records.append(record.getMessage())

    async with client_with(log_requests=True) as client:
        logger = logging.getLogger("litestar")
        handler = Collect()
        logger.addHandler(handler)
        try:
            headers = auth_headers()
            token = headers["Authorization"].removeprefix("Bearer ")
            await client.get("/api/me", headers=headers)
            await client.get("/api/health")
        finally:
            logger.removeHandler(handler)

    logged = "\n".join(records)
    assert "/api/me" in logged
    assert "status_code=200" in logged
    assert token not in logged
    assert "/api/health" not in logged  # probes are excluded
