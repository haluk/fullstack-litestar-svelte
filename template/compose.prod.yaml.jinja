services:
  db:
    image: postgres:18-alpine
    environment:
      POSTGRES_DB: {{ db_name }}
      POSTGRES_USER: {{ db_user }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
    volumes:
      - db_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_user }} -d {{ db_name }}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  keycloak-db:
    image: postgres:18-alpine
    environment:
      POSTGRES_DB: keycloak
      POSTGRES_USER: keycloak
      POSTGRES_PASSWORD: ${KEYCLOAK_DB_PASSWORD:?set KEYCLOAK_DB_PASSWORD}
    volumes:
      - keycloak_db_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U keycloak -d keycloak"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  keycloak:
    image: quay.io/keycloak/keycloak:26.8.1
    # Imports the realm on first boot only; later boots keep what was changed in the console.
    command: start --import-realm
    depends_on:
      keycloak-db:
        condition: service_healthy
    environment:
      KC_DB: postgres
      KC_DB_URL: jdbc:postgresql://keycloak-db:5432/keycloak
      KC_DB_USERNAME: keycloak
      KC_DB_PASSWORD: ${KEYCLOAK_DB_PASSWORD}
      KC_BOOTSTRAP_ADMIN_USERNAME: admin
      KC_BOOTSTRAP_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD:?set KEYCLOAK_ADMIN_PASSWORD}
      # served by nginx under /auth; TLS (if any) terminates in front of nginx
      KC_HTTP_RELATIVE_PATH: /auth
      KC_HTTP_ENABLED: "true"
      KC_PROXY_HEADERS: xforwarded
      KC_HOSTNAME: ${ORIGIN:-http://localhost}/auth
      KC_HOSTNAME_BACKCHANNEL_DYNAMIC: "true"
      KC_HEALTH_ENABLED: "true"
      # resolved inside realm.json at import time
      KEYCLOAK_CLIENT_SECRET: ${KEYCLOAK_CLIENT_SECRET:?set KEYCLOAK_CLIENT_SECRET}
      APP_ORIGIN: ${ORIGIN:-http://localhost}
    volumes:
      - ./deploy/keycloak/realm.json:/opt/keycloak/data/import/realm.json:ro
    restart: unless-stopped

  api:
    build:
      context: ./backend
      target: runtime
    depends_on:
      db:
        condition: service_healthy
    environment:
      DATABASE_URL: postgresql+asyncpg://{{ db_user }}:${POSTGRES_PASSWORD}@db:5432/{{ db_name }}
      KEYCLOAK_URL: ${ORIGIN:-http://localhost}/auth
      KEYCLOAK_INTERNAL_URL: http://keycloak:8080/auth
      KEYCLOAK_REALM: {{ project_slug }}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
      LOG_REQUESTS: ${LOG_REQUESTS:-true}
      # comma-separated; empty disables CORS (browsers only talk to SvelteKit on this origin)
      CORS_ORIGINS: ${CORS_ORIGINS:-}
      # comma-separated Host allowlist, e.g. "api,{{ domain }}"; empty accepts any
      ALLOWED_HOSTS: ${ALLOWED_HOSTS:-}
      RATE_LIMIT_PER_MINUTE: ${RATE_LIMIT_PER_MINUTE:-300}
      # /metrics is reachable only inside the compose network (nginx doesn't route it)
      METRICS_ENABLED: ${METRICS_ENABLED:-false}
      LITESTAR_APP: {{ package_name }}.app:app
    command: sh -c "litestar database upgrade --no-prompt && litestar run --host 0.0.0.0 --port 8000"
    restart: unless-stopped

  web:
    build:
      context: ./frontend
      target: runtime
    depends_on:
      - api
      - keycloak
    environment:
      INTERNAL_API_URL: http://api:8000
      KEYCLOAK_URL: ${ORIGIN:-http://localhost}/auth
      KEYCLOAK_INTERNAL_URL: http://keycloak:8080/auth
      KEYCLOAK_REALM: {{ project_slug }}
      KEYCLOAK_CLIENT_ID: {{ project_slug }}-web
      KEYCLOAK_CLIENT_SECRET: ${KEYCLOAK_CLIENT_SECRET}
      # adapter-node derives the public origin from nginx's forwarded headers
      PROTOCOL_HEADER: x-forwarded-proto
      HOST_HEADER: x-forwarded-host
      ADDRESS_HEADER: x-forwarded-for
      XFF_DEPTH: "1"
      BODY_SIZE_LIMIT: 10M
    restart: unless-stopped

  nginx:
    image: nginx:1.31-alpine
    depends_on:
      - api
      - web
      - keycloak
    ports:
      - "80:80"
    volumes:
      - ./deploy/nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    restart: unless-stopped

volumes:
  db_data:
  keycloak_db_data:
